# Database Configuration
# Development (Docker Compose): postgresql://postgres:postgres@db:5432/app
# Production (Neon.tech):       postgresql://user:pass@ep-xxx.region.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@db:5432/app

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Classroom Reservation System

# Security (generate a strong random value for production)
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# SQLAlchemy
SQLALCHEMY_ECHO=False

# CORS — must be a JSON array string (pydantic-settings v2 parses list[str] as JSON)
# Development:
CORS_ORIGINS=["http://localhost:3000"]
# Production (add your Render frontend URL):
# CORS_ORIGINS=["https://classroom-frontend.onrender.com"]
